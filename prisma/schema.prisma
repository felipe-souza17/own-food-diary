generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MealType {
  BREAKFAST
  MORNING_SNACK
  LUNCH
  AFTERNOON_SNACK
  DINNER
  SUPPER
  OTHER

  @@map("meal_type")
}

enum NutritionStatus {
  PENDING
  DONE
  FAILED
  FREE_MEAL

  @@map("nutrition_status")
}

model Meal {
  id          String         @id @default(uuid()) @db.Uuid
  date        DateTime       @db.Date
  mealType    MealType       @map("meal_type")
  description String         @db.VarChar(500)
  notes       String?        @db.VarChar(1000)
  images      MealImage[]
  nutrition   MealNutrition?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([date])
  @@index([mealType])
  @@map("meals")
}

model MealNutrition {
  id        String          @id @default(uuid()) @db.Uuid
  mealId    String          @unique @map("meal_id") @db.Uuid
  meal      Meal            @relation(fields: [mealId], references: [id], onDelete: Cascade)
  status    NutritionStatus @default(PENDING)
  calories  Float?
  protein   Float?
  carbs     Float?
  fat       Float?
  fiber     Float?
  /// Itens estimados: [{ nome, gramas, calories, protein, carbs, fat, fiber }]
  items     Json?
  /// Ajuste manual: quando true, não recalcular automaticamente.
  isManual  Boolean         @default(false) @map("is_manual")
  model     String?
  analyzedAt DateTime?      @map("analyzed_at")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@map("meal_nutrition")
}

model DailyLog {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @unique @db.Date
  waterMl   Int      @default(0) @map("water_ml")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("daily_logs")
}

model MealImage {
  id        String   @id @default(uuid()) @db.Uuid
  url       String   @db.Text
  pathname  String   @db.Text
  mealId    String   @map("meal_id") @db.Uuid
  meal      Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([mealId])
  @@map("meal_images")
}

model ShareLink {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique @db.VarChar(32)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([token, isActive])
  @@map("share_links")
}

/// Configurações globais da aplicação (linha única, id = "app").
model AppSettings {
  id              String   @id @default("app")
  /// Meta/limite diário de calorias (kcal). 0 = sem meta definida.
  calorieGoalKcal Int      @default(2000) @map("calorie_goal_kcal")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

/// Dica diária do coach (cache por dia; regenerada quando as refeições mudam).
model DailyCoachTip {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @unique @db.Date
  tip       String   @db.Text
  /// Hash do estado do dia (meta + refeições); muda ⇒ regenerar a dica.
  mealsHash String   @map("meals_hash") @db.VarChar(64)
  model     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("daily_coach_tips")
}

/// Conquista desbloqueada (uma linha por badge; `key` referencia o catálogo).
model Achievement {
  id         String   @id @default(uuid()) @db.Uuid
  key        String   @unique @db.VarChar(64)
  unlockedAt DateTime @default(now()) @map("unlocked_at")

  @@map("achievements")
}
