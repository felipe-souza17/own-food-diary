# ---------------------------------------------------------------------------
# Diário Alimentar — Variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores.
# ---------------------------------------------------------------------------

# URL de conexão do PostgreSQL (Neon).
# Obtenha em: https://console.neon.tech → seu projeto → "Connection string".
# Exemplo: postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# Segredo usado para assinar os tokens de sessão (JWT) do Auth.js.
# Gere um valor com: openssl rand -base64 32
NEXTAUTH_SECRET=""

# URL base da aplicação.
# Local: http://localhost:3000 | Produção: https://seu-dominio.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Token de leitura/escrita do Vercel Blob Storage.
# Obtenha em: Vercel → seu projeto → Storage → Blob → ".env.local" tab.
BLOB_READ_WRITE_TOKEN=""

# Credenciais do (único) usuário administrador.
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha"

# Análise nutricional automática (opcional).
# Chave gratuita do Google AI Studio: https://aistudio.google.com/app/apikey
# Sem esta chave o app funciona normalmente, apenas sem cálculo de kcal/macros.
GEMINI_API_KEY=""
# Modelo do Gemini (opcional). Padrão definido em src/lib/constants.ts.
GEMINI_MODEL="gemini-3.1-flash-lite"
